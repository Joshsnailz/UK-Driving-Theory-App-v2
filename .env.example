# ──────────────────────────────────────────────────────────────────────────
# UK Theory Test — local environment template
# Copy to `.env` and fill in. None of these values are secret enough to keep
# out of a client bundle, but they ARE environment-specific. Production
# builds should set these as EAS secrets (`eas secret:create`).
# ──────────────────────────────────────────────────────────────────────────

# App identity
IOS_BUNDLE_ID=com.joshsnailz.uktheory
ANDROID_PACKAGE=com.joshsnailz.uktheory
EAS_PROJECT_ID=

# Firebase — paths to the platform config files downloaded from the
# Firebase console. Keep the files OUT of git (see .gitignore).
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
GOOGLE_SERVICES_JSON=./google-services.json

# Google Sign-In — the *Web* OAuth client ID from the Firebase console
# (Authentication → Sign-in method → Google → Web SDK configuration).
GOOGLE_WEB_CLIENT_ID=

# RevenueCat — public SDK keys (NOT the secret key).
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=

# AdMob — App IDs (used by the native plugin) and ad-unit IDs (used at runtime).
# The defaults in app.config.ts are Google's published test IDs.
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=

# Legal
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
